# Salin isi file ini ke `.env.local`, lalu sesuaikan alamat API.
#
#   cp .env.example .env.local
#
# Muat ulang `npm run dev` setelah mengubah file ini — Next.js membaca
# variabel NEXT_PUBLIC_* saat build, bukan saat runtime.

# ---------------------------------------------------------------
# Alamat API backend
# ---------------------------------------------------------------
# Pilih SATU yang sesuai kondisi komputermu, dan hapus baris lainnya.
#
# 1) Backend Laradock jalan di laptopmu sendiri (paling umum saat ngoding).
#    `pm-monitoring.test` hanya ada di /etc/hosts laptop yang menjalankan
#    Docker — di laptop lain alamat ini tidak menunjuk ke mana pun.
# NEXT_PUBLIC_API_URL=http://pm-monitoring.test/api/v1
#
# 2) Backend jalan lewat `php artisan serve` di laptopmu.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
#
# 3) Backend jalan di laptop rekan tim (satu jaringan Wi-Fi yang sama).
#    Ganti dengan IP lokal laptop tersebut, mis. 192.168.1.10.
# NEXT_PUBLIC_API_URL=http://192.168.1.10/api/v1
#
# Tanpa baris di atas, aplikasi memakai http://pm-monitoring.test/api/v1
# dan akan gagal dengan pesan "Tidak bisa menghubungi server".
NEXT_PUBLIC_API_URL=http://pm-monitoring.test/api/v1

# Nama lama, masih didukung (dipakai kalau NEXT_PUBLIC_API_URL kosong)
# NEXT_PUBLIC_API_BASE_URL=http://pm-monitoring.test/api/v1

# ---------------------------------------------------------------
# Aplikasi
# ---------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Sehatkita
NEXT_PUBLIC_APP_VERSION=0.1.0

# ---------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=false

# Monitoring (produksi saja)
# NEXT_PUBLIC_SENTRY_DSN=https://...
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
