# Salin isi file ini ke `.env.local`:
#
#   cp .env.example .env.local
#
# Isinya sudah cukup untuk pemakaian normal. Ubah hanya kalau backendmu
# berada di tempat lain.

# ---------------------------------------------------------------
# Alamat backend (dipakai SERVER, bukan browser)
# ---------------------------------------------------------------
# Frontend meneruskan /api/v1/* ke alamat ini lewat rewrite Next.js
# (lihat next.config.ts). Browser selalu memanggil origin yang sama, jadi
# tidak ada CORS dan tidak ada masalah "Failed to fetch".
#
# Pilih SATU yang sesuai kondisi komputermu:
#
# 1) Backend Laradock di laptopmu sendiri (paling umum).
#    `pm-monitoring.test` hanya dikenali di laptop yang menjalankan Docker.
# API_PROXY_TARGET=http://pm-monitoring.test
#
# 2) Backend lewat `php artisan serve` di laptopmu.
# API_PROXY_TARGET=http://127.0.0.1:8000
#
# 3) Backend di laptop rekan tim, satu jaringan Wi-Fi.
# API_PROXY_TARGET=http://192.168.1.10
#
# Tanpa baris di atas, dipakai http://pm-monitoring.test.
# API_PROXY_TARGET=http://pm-monitoring.test

# ---------------------------------------------------------------
# Opsional: panggil backend langsung dari browser
# ---------------------------------------------------------------
# Isi ini HANYA kalau backend memang sudah mengizinkan origin frontendmu
# (CORS diatur tim backend). Selama kosong, aplikasi memakai jalur proxy di
# atas dan tidak pernah kena CORS.
# NEXT_PUBLIC_API_URL=http://pm-monitoring.test/api/v1

# ---------------------------------------------------------------
# Aplikasi
# ---------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Sehatkita
NEXT_PUBLIC_APP_VERSION=0.1.0

# ---------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=false

# Monitoring (produksi saja)
# NEXT_PUBLIC_SENTRY_DSN=https://...
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
